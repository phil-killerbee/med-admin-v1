# Copier ce fichier en server/.env et adapter.
# server/.env ne doit JAMAIS être commité (il est dans .gitignore).

API_PORT=3001

# MySQL de WAMP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mediciel-test

# Secret de signature des sessions : une longue chaîne aléatoire
# (ex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
