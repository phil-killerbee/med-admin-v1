{
  "name": "pharmacie-react-cours",
  "private": true,
  "version": "1.0.0",
  "description": "Logiciel de pharmacie pédagogique en React : bonnes pratiques et gestion des rôles (RBAC)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:reseau": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"vite --host\"",
    "dev:api": "node --watch --env-file-if-exists=server/.env server/index.js",
    "start:api": "node --env-file-if-exists=server/.env server/index.js",
    "db:init": "node --env-file-if-exists=server/.env server/db/init.js",
    "db:reset": "node --env-file-if-exists=server/.env server/db/init.js --reset",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "mysql2": "^3.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
